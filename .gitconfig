[user]
    name = William Ellett
	email = william.ellett@sensorfact.nl
[core] 
    editor = vim
    excludesfile = ~/.global_gitignore
[diff] 
    tool = vimdiff
[merge]
	tool = vimdiff
[pull]
    rebase=true
[difftool] 
    prompt = false
[alias]
    update = add -u
[mergetool]
    keepBackup = false
[rebase] 
    autosquash = true
[init]
    defaultBranch = main
[includeIf "gitdir:~/repositories/sensorfact/"]
    path = ~/.gitconfig-sensorfact
    
